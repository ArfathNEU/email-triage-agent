# Anthropic — get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-replace-me
ANTHROPIC_MODEL=claude-opus-4-7

# Server
PORT=3001
NODE_ENV=development

# SQLite database file
DATABASE_PATH=./data/triage.db

# Agent
MAX_EMAIL_BODY_CHARS=4000
AGENT_CONCURRENCY=5

# Optional. In production, restrict CORS to your frontend origin
# (e.g., CORS_ORIGIN=https://your-app.vercel.app). Leave unset for local dev.
CORS_ORIGIN=